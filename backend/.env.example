# ──────────────────────────────────────────────────────────────────────────
# ArchMemory – Environment Configuration
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────

# ── Hindsight ─────────────────────────────────────────────────────────────
# URL of your running Hindsight instance.
# Self-hosted (Docker): http://localhost:8888
# Hindsight Cloud:      https://api.hindsight.vectorize.io
HINDSIGHT_BASE_URL=http://localhost:8888

# API key (only required for Hindsight Cloud; leave empty for self-hosted)
HINDSIGHT_API_KEY=

# The memory bank name for all architecture decisions.
# Change this only if you need to isolate environments.
HINDSIGHT_BANK_ID=architecture_decisions

# ── LLM ───────────────────────────────────────────────────────────────────
# Provider: groq | openai
LLM_PROVIDER=groq

# Groq endpoint (leave as-is for Groq cloud)
LLM_BASE_URL=https://api.groq.com/openai/v1

# Your Groq (or OpenAI) API key
LLM_API_KEY=your-groq-or-openai-api-key-here

# Model to use. Groq recommendations:
#   qwen/qwen3-32b          – fast, strong reasoning
#   openai/gpt-oss-120b     – more powerful, slower
# OpenAI recommendations:
#   gpt-4o                  – if using OpenAI directly
LLM_MODEL=qwen/qwen3-32b

# Temperature: keep low for grounded, factual briefings
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ── Database ──────────────────────────────────────────────────────────────
# SQLite (default, no extra setup needed)
DATABASE_URL=sqlite+aiosqlite:///./archmemory.db

# PostgreSQL (optional, production-grade)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/archmemory

# ── Auth ──────────────────────────────────────────────────────────────────
# Every API route except login and health requires a signed-in user.
# Set to false ONLY for local experiments: the API is then open to anyone who
# can reach it.
AUTH_ENABLED=true

# Required. At least 32 characters; the API refuses to start otherwise.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# HS256 | HS384 | HS512
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# The browser session is an httpOnly cookie. Set this to true whenever the app
# is served over HTTPS (browsers will not send a Secure cookie over plain HTTP).
AUTH_COOKIE_SECURE=false

# First-run account. If the users table is empty and ADMIN_PASSWORD is set
# (at least 10 characters), this account is created at startup. Changing these
# later has no effect; use `python scripts/create_user.py` to add or update users.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Lock a username out for LOGIN_LOCKOUT_SECONDS after this many failed sign-ins.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=300

# ── App ───────────────────────────────────────────────────────────────────
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]

# Number of memories recalled per briefing (increase for richer context)
RECALL_TOP_K=15
